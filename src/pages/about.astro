---
import Layout from '../layout/Layout.astro';
import Hero from '../components/Hero/Hero.astro';
---

<Layout title="About - CloudCannon Test" description="Learn more about our project">
  <Hero title="About Us" content="Learn more about our mission, team, and technology stack." />
	<section>
		<h2>Our Mission</h2>
		<p>We're building a simple, clean website using Astro with reusable layouts and slots.</p>
	</section>
	
	<section>
		<h2>Technology Stack</h2>
		<ul>
			<li>Astro - Static site generator</li>
			<li>TypeScript - Type safety</li>
			<li>CloudCannon - Content management</li>
		</ul>
	</section>
</Layout> 